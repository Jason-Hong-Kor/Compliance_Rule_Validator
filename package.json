{
  "name": "compliance-rule-validator",
  "version": "1.0.0",
  "private": true,
  "description": "Atlassian Forge app that validates Jira issues and Confluence pages against Confluence-hosted compliance rulebooks using an LLM.",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:workflow-ui": "node scripts/build-workflow-ui.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "npm run typecheck && npm run build:workflow-ui && npm run check:manifest",
    "lint": "forge lint",
    "register": "forge register",
    "deploy": "npm run build:workflow-ui && forge deploy -e development",
    "tunnel": "forge tunnel"
  },
  "dependencies": {
    "@forge/api": "^8.0.4",
    "@forge/bridge": "^6.3.0",
    "@forge/events": "^3.0.4",
    "@forge/kvs": "^2.0.4",
    "@forge/jira-bridge": "^0.40.1",
    "@forge/react": "^12.1.2",
    "@forge/resolver": "^2.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@forge/cli": "^13.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.31",
    "js-yaml": "^5.4.0",
    "esbuild": "^0.25.9",
    "typescript": "^7.0.2"
  }
}
